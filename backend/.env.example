# ════════════════════════════════════════════════════════════════════════════
#  Yatra AI — backend (NestJS) environment
#  Copy to backend/.env and fill in. Only OPENAI_API_KEY is mandatory; every
#  other provider has a keyless fallback (see README §5).
# ════════════════════════════════════════════════════════════════════════════

# ─── Server ─────────────────────────────────────────────────────────────────
# API port (REST, AG-UI SSE, Socket.IO, Swagger at /api/docs)
PORT=4100
# Browser origin(s) allowed by CORS — the Next.js app. Comma-separate multiple.
CORS_ORIGIN=http://localhost:3100

# ─── LLM (REQUIRED) ─────────────────────────────────────────────────────────
# OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key
# Any OpenAI chat model with tool calling + structured outputs (e.g. gpt-4.1, gpt-4.1-mini, gpt-4o)
OPENAI_MODEL=gpt-4.1

# ─── Database (REQUIRED) ────────────────────────────────────────────────────
# PostgreSQL from docker-compose.yml (host port 5433). Used for trips + LangGraph checkpoints.
DATABASE_URL=postgres://travel:travel@localhost:5433/travel_planner

# ─── Maps, places, hotels, routing (optional) ───────────────────────────────
# Ola Maps (Krutrim, India): geocoding, place/hotel search, directions.
# Get a key: https://maps.olakrutrim.com  → blank = OpenStreetMap Nominatim/Wikipedia/OSRM (keyless, 1 req/s)
OLA_MAPS_API_KEY=

# ─── Trains (optional) ──────────────────────────────────────────────────────
# IRCTC train data via RapidAPI (irctc1): https://rapidapi.com/IRCTCAPI/api/irctc1
RAPIDAPI_KEY=
# erail.in public timetable (keyless, unofficial) — real trains on the travel date. "false" to disable.
ERAIL_ENABLED=true

# ─── Weather (optional) ─────────────────────────────────────────────────────
# IMD district-wise warnings and Open-Meteo forecasts need NO key.
# IMD 7-day city forecast (free for non-commercial use) needs registration + IP whitelisting:
#   portal:        https://api.imd.gov.in
#   whitelisting:  https://city.imd.gov.in/citywx/api_request.php
# Sent as headers  X-API-Key: <IMD_API_KEY>  and  Authorization: Bearer <IMD_JWT>
IMD_API_KEY=
IMD_JWT=

# ─── News & events (optional) ───────────────────────────────────────────────
# NewsData.io (India): https://newsdata.io  → blank = Google News India RSS (keyless)
NEWSDATA_API_KEY=

# ─── Observability (optional) ───────────────────────────────────────────────
# LangSmith tracing of every graph run, agent, LLM and tool call: https://smith.langchain.com
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=india-travel-planner
# Only for self-hosted / EU LangSmith; leave blank for the default endpoint
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
