# ════════════════════════════════════════════════════════════════════════════
#  Yatra AI — frontend (Next.js) environment
#  Copy to frontend/.env.local. NEXT_PUBLIC_* values are inlined at build time,
#  so rebuild (pnpm build) after changing them.
# ════════════════════════════════════════════════════════════════════════════

# Backend base URL — used for REST (/api/trips, /api/health) and the AG-UI endpoint (/api/agui)
NEXT_PUBLIC_API_URL=http://localhost:4100
