# ════════════════════════════════════════════════════════════════════════════
#  Yatra AI — Docker Compose (PostgreSQL)
#  Copy to ./.env (optional — these are the defaults). If you change them,
#  update DATABASE_URL in backend/.env to match:
#    postgres://POSTGRES_USER:POSTGRES_PASSWORD@localhost:POSTGRES_PORT/POSTGRES_DB
#
#  Other env files:  backend/.env.example  → backend/.env
#                    frontend/.env.example → frontend/.env.local
# ════════════════════════════════════════════════════════════════════════════
POSTGRES_USER=travel
POSTGRES_PASSWORD=travel
POSTGRES_DB=travel_planner
POSTGRES_PORT=5433
